{
  "extraKnownMarketplaces": {
    "product-builder-kit": {
      "source": {
        "source": "github",
        "repo": "BaptisteCavalie/product-builder"
      }
    }
  },
  "enabledPlugins": {
    "product-builder@product-builder-kit": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
